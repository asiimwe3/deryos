# Copy to .env and fill in. Never commit .env.
PORT=8787
NODE_ENV=development

# Signing secret for Derycode ID tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# AI gateway. The model key stays here, on the server. The app never sees it.
AI_PROVIDER_URL=
AI_API_KEY=
AI_MODEL=

# Phase 2 database (PostgreSQL or Supabase). Left empty, the API uses the
# in-memory store so the prototype still runs.
DATABASE_URL=
